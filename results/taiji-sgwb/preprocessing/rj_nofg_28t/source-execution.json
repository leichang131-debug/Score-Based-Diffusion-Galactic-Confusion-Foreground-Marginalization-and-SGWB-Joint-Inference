    },
    {
      "line": 19,
      "end_line": 19,
      "source": "from taijisgwb.detector.tdi import tdi_X2, aet_from_xyz, tdi_aet_from_tdi_x"
    },
    {
      "line": 20,
      "end_line": 20,
      "source": "from taijisgwb.detector.noise import TaijiNoisePSD"
    },
    {
      "line": 21,
      "end_line": 21,
      "source": "from taijisgwb import Interferometer"
    },
    {
      "line": 22,
      "end_line": 22,
      "source": "from taijisgwb.detector.orbit import InterpolationOrbit"
    },
    {
      "line": 23,
      "end_line": 23,
      "source": "from taijisgwb.waveform import calc_omega_powerlaw"
    },
    {
      "line": 24,
      "end_line": 24,
      "source": "from taijisgwb.utils import psd_from_omega"
    },
    {
      "line": 26,
      "end_line": 27,
      "source": "logging.basicConfig(level = logging.INFO, \n                    format = \"%(asctime)s - %(levelname)s: %(message)s\")"
    },
    {
      "line": 28,
      "end_line": 28,
      "source": "multiprocessing.set_start_method(\"fork\")"
    },
    {
      "line": 30,
      "end_line": 30,
      "source": "PROJ_DIR = Path(\"/home/yang/WorkSpace/taiji_data_challenge_sgwb\")"
    },
    {
      "line": 31,
      "end_line": 31,
      "source": "PARENT_DIR = Path(__file__).parent"
    },
    {
      "line": 35,
      "end_line": 35,
      "source": "f_analow, f_anaupp = 1e-4, 5e-2"
    },
    {
      "line": 36,
      "end_line": 36,
      "source": "f_res = 1e-5"
    },
    {
      "line": 37,
      "end_line": 37,
      "source": "tperseg = 7. * 24 * 3600"
    },
    {
      "line": 38,
      "end_line": 38,
      "source": "npool = 62"
    },
    {
      "line": 40,
      "end_line": 40,
      "source": "strain_file = PROJ_DIR / \"data/TDCII2-8.h5\""
    },
    {
      "line": 41,
      "end_line": 41,
      "source": "result_outdir = PARENT_DIR / \"results/\""
    },
    {
      "line": 42,
      "end_line": 42,
      "source": "asd_img_name = \"asd_AET_nofg.png\""
    },
    {
      "line": 43,
      "end_line": 43,
      "source": "backend_name = \"rj_AET_nofg.h5\""
    },
    {
      "line": 46,
      "end_line": 46,
      "source": "save_path = Path(result_outdir)"
    },
    {
      "line": 47,
      "end_line": 47,
      "source": "save_path.mkdir(parents=True, exist_ok=True)"
    },
    {
      "line": 51,
      "end_line": 51,
      "source": "logging.info(\"Read simulation results.\")"
    },
    {
      "line": 52,
      "end_line": 52,
      "source": "tdi_names = [\"A\", \"E\", \"T\"]"
    },
    {
      "line": 53,
      "end_line": 53,
      "source": "ntdi = len(tdi_names)"
    },
    {
      "line": 54,
      "end_line": 54,
      "source": "tdi_methods = tdi_aet_from_tdi_x(tdi_X2)"
    },
    {
      "line": 56,
      "end_line": 58,
      "source": "with h5py.File(strain_file, \"r\") as f:\n    time = f[\"data\"][\"time\"][()]\n    strain_X2, strain_Y2, strain_Z2 = f[\"data\"][\"XYZ\"][()] - f[\"data\"][\"foreground\"][()]"
    },
    {
      "line": 60,
      "end_line": 60,
      "source": "dt = time[1] - time[0]"
    },
    {
      "line": 61,
      "end_line": 61,
      "source": "fsample = 1. / dt"
    },
    {
      "line": 62,
      "end_line": 62,
      "source": "ndrop_points = int(2000 * fsample)"
    },
    {
      "line": 64,
      "end_line": 64,
      "source": "time = time[ndrop_points:-ndrop_points]"
    },
    {
      "line": 65,
      "end_line": 65,
      "source": "strain_AET2 = aet_from_xyz(strain_X2, strain_Y2, strain_Z2)"
    },
    {
      "line": 66,
      "end_line": 67,
      "source": "strain_AET2 = [strain_AET2[i][ndrop_points:-ndrop_points]\n              for i in range(ntdi)]"
    },
    {
      "line": 70,
      "end_line": 70,
      "source": "nperseg = int(tperseg * fsample)"
    },
    {
      "line": 71,
      "end_line": 71,
      "source": "nseg = len(time) // nperseg"
    },
    {
      "line": 72,
      "end_line": 72,
      "source": "tperseg = nperseg * dt"
    },
    {
      "line": 73,
      "end_line": 73,
      "source": "f_low = 1. / tperseg"
    },
    {
      "line": 74,
      "end_line": 74,
      "source": "nperbin = int(f_res / f_low)"
    },
    {
      "line": 75,
      "end_line": 75,
      "source": "logging.info(f\"Cut into {nseg} segments, {tperseg/3600/24 :.1f} days per segment.\")"
    },
    {
      "line": 76,
      "end_line": 76,
      "source": "logging.info(f\"Binning in frequency domain, {nperbin} per bin.\")"
    },
    {
      "line": 78,
      "end_line": 78,
      "source": "f_est = np.arange(nperseg//2+1) * f_low"
    },
    {
      "line": 79,
      "end_line": 79,
      "source": "nbin = len(f_est) // nperbin"
    },
    {
      "line": 81,
      "end_line": 81,
      "source": "win_array = windows.kaiser(M=nperseg, beta=14)"
    },
    {
      "line": 82,
      "end_line": 82,
      "source": "win_bw = nperseg * np.sum(win_array**2) / np.sum(win_array)**2"
    },
    {
      "line": 83,
      "end_line": 83,
      "source": "logging.info(f\"Normalized equivalent noise bandwidth of window: {win_bw :.1f} bins.\")"
    },
    {
      "line": 84,
      "end_line": 85,
      "source": "SFT = ShortTimeFFT(win_array, nperseg, fsample,\n                   fft_mode=\"onesided\", scale_to=\"psd\")"
    },
    {
      "line": 86,
      "end_line": 86,
      "source": "strain_segs = np.empty((ntdi, nseg, len(f_est)), dtype=complex)"
    },
    {
      "line": 87,
      "end_line": 89,
      "source": "for i, strain in enumerate(strain_AET2):\n    strain_segs[i] = SFT.stft_detrend(strain, \"constant\",\n                                        p0=0, p1=nseg, k_offset=nperseg//2).T"
    },
    {
      "line": 91,
      "end_line": 91,
      "source": "csd_est = np.conj(strain_segs[:, None, :, :]) * strain_segs[None, :, :, :]"
    },
    {
      "line": 93,
      "end_line": 93,
      "source": "csd_est = csd_est[..., :(nbin*nperbin)].reshape(ntdi, ntdi, nseg, -1, nperbin)"
    },
    {
      "line": 94,
      "end_line": 94,
      "source": "csd_est = np.mean(csd_est, axis=-1) * 2."
    },
    {
      "line": 95,
      "end_line": 95,
      "source": "f_est = np.mean(f_est[:(nbin*nperbin)].reshape(-1, nperbin), axis=-1)"
    },
    {
      "line": 98,
      "end_line": 98,
      "source": "mask = (f_est >= f_analow) & (f_est < f_anaupp)"
    },
    {
      "line": 99,
      "end_line": 99,
      "source": "f_est = f_est[mask]"
    },
    {
      "line": 100,
      "end_line": 100,
      "source": "csd_est = csd_est[..., mask]"
    },
    {
      "line": 103,
      "end_line": 108,
      "source": "def notch_mask(x, intervals):\n    ans = np.ones_like(x, dtype=bool)\n    for interval in intervals:\n        idx = (x >= interval[0]) & (x < interval[1])\n        ans[idx] = False\n    return ans"
    },
    {
      "line": 110,
      "end_line": 112,
      "source": "f_notch = [\n    (2.35e-2, 2.65e-2), (4.7e-2, 5.2e-2),\n]"
    },
    {
      "line": 114,
      "end_line": 115,
      "source": "for i in range(ntdi):\n    plt.loglog(f_est, (np.mean(csd_est[i, i].real, axis=0))**.5, label=tdi_names[i])"
    },
    {
      "line": 116,
      "end_line": 117,
      "source": "for interval in f_notch:\n    plt.axvspan(*interval, color=\"grey\", alpha=.5)"
    },
    {
      "line": 118,
      "end_line": 118,
      "source": "plt.grid()"
    },
    {
      "line": 119,
      "end_line": 119,
      "source": "plt.xlabel(\"Frequency\")"
    },
    {
      "line": 120,
      "end_line": 120,
      "source": "plt.ylabel(\"ASD\")"
    },
    {
      "line": 121,
      "end_line": 121,
      "source": "plt.legend()"
    },
    {
      "line": 122,
      "end_line": 122,
      "source": "plt.title(\"Average ASD of TDI variables\")"
    },
    {
      "line": 123,
      "end_line": 123,
      "source": "plt.savefig(PARENT_DIR / asd_img_name, bbox_inches=\"tight\", dpi=300)"
    },
    {
      "line": 124,
      "end_line": 124,
      "source": "plt.close()"
    },
    {
      "line": 126,
      "end_line": 126,
      "source": "mask = notch_mask(f_est, f_notch)"
    },
    {
      "line": 127,
      "end_line": 127,
      "source": "f_est = f_est[mask]"
    },
    {
      "line": 128,
      "end_line": 128,
      "source": "nf_est = len(f_est)"
    },
    {
      "line": 129,
      "end_line": 129,
      "source": "csd_est = csd_est[..., mask]"
    }
